#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N pld2_fold
#PBS -l walltime=02:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe

# Standalone ESMFold pass over SAMPLES_DIR. Use this to catch up on a backlog of sample FASTAs, or
# to fold a training run's output after the fact.
#
# All 12 tiles by default, but with NO PROCESS GROUP: src.fold_fasta calls
# dist.init_distributed(no_dist=True), which pins each rank's tile without ever initialising oneCCL.
# oneCCL's IPC peer mappings are what made multi-rank folding fault on Aurora, not rank count; see
# the longer note in scripts/train.pbs. Ranks partition work by a stable hash of each sequence id and
# each appends to its own <out>.rankNNN.jsonl, so no collective and no shared-file writes.
#
#   qsub -v RANKS_PER_NODE=1 scripts/fold.pbs      # the fallback with direct evidence behind it
#
# Resumable: every scored sequence is fsynced to FOLDS_JSONL and a rerun skips ids already there, so
# re-submitting after a GPU fault costs only the sequences that were in flight.
#
#   qsub scripts/fold.pbs                                    # one pass over everything new
#   qsub -v FOLD_ARGS="--watch --max-idle 1800" scripts/fold.pbs   # follow a running training job
#   qsub -v FOLD_ARGS="--max-len 300" scripts/fold.pbs        # cap length (ESMFold cost is ~L^2)
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./scripts/pbs_common.sh

job_banner "PLD2 ESMFold pass (src.fold_fasta)" FOLD_ARGS

# shellcheck disable=SC2086  # FOLD_ARGS is deliberately word-split into separate flags
"${MPI_LAUNCH[@]}" python -m src.fold_fasta --device xpu ${FOLD_ARGS:-}
rc=$?; echo "[job] exit $rc"; exit $rc     # exit $rc so the EXIT trap reports the true code
