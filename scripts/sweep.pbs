#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N pld2_sweep
#PBS -l walltime=01:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe

# Sampler sweep: generate one FASTA per decode configuration, fold them all, print one table.
#
# Both phases use all 12 tiles with NO PROCESS GROUP -- src.sweep_sampler and src.fold_fasta both
# call dist.init_distributed(no_dist=True), which reads the MPI topology and pins each rank's tile
# without ever initialising oneCCL. See the note in scripts/train.pbs for why that distinction is
# what makes multi-rank folding safe here.
#
# Phase 1 gives each rank a subset of the configurations (they write disjoint filenames, so nothing
# needs aggregating). Phase 2 folds every sweep FASTA, partitioned by a stable hash of each sequence
# id, into per-rank JSONLs. Phase 3 prints the summary, which reads all of them plus the existing
# natural/shuffled rows -- so the sweep lands in the same table with the same reference lines.
#
# Already-scored sequences are skipped on content, so re-submitting after a fault costs only what
# was in flight, and re-running the sweep after a NEW checkpoint re-folds properly (same filenames,
# different sequences -> different content key).
#
#   qsub scripts/sweep.pbs
#   qsub -v N=128 scripts/sweep.pbs                        # more sequences per configuration
#   qsub -v SWEEP_ARGS="--only no_reppen,nr_t0.8" scripts/sweep.pbs
#   qsub -v CKPT=/path/to/ckpt_00049999.pt scripts/sweep.pbs
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./scripts/pbs_common.sh

N=${N:-64}                                  # sequences per configuration
SAMPLES=$(python -c "from config import SAMPLES_DIR; print(SAMPLES_DIR)")
job_banner "PLD2 sampler sweep (generate -> fold -> summarise)" N SAMPLES CKPT SWEEP_ARGS FOLD_ARGS

CKPT_FLAG=""
[ -n "${CKPT:-}" ] && CKPT_FLAG="--ckpt ${CKPT}"

# --- phase 1: generate, one rank per configuration ------------------------------------------
echo "[sweep] phase 1/3: generating ${N} sequences per configuration on ${NRANKS} tile(s)"
# shellcheck disable=SC2086  # CKPT_FLAG and SWEEP_ARGS are deliberately word-split into flags
"${MPI_LAUNCH[@]}" python -m src.sweep_sampler --device xpu --n "${N}" ${CKPT_FLAG} ${SWEEP_ARGS:-}
rc=$?
if [ $rc -ne 0 ]; then echo "[sweep] generation failed (rc=$rc); nothing to fold." >&2; exit $rc; fi

# --- phase 2: fold every sweep FASTA --------------------------------------------------------
# Only the sweep_*.fasta files: the step_*.fasta from training are already scored and would be
# skipped anyway, but naming them explicitly keeps the log readable and the intent obvious.
shopt -s nullglob
SWEEP_FASTA=( "${SAMPLES}"/sweep_*.fasta )
shopt -u nullglob
if [ ${#SWEEP_FASTA[@]} -eq 0 ]; then
    echo "[sweep] no sweep_*.fasta in ${SAMPLES} -- generation wrote nothing." >&2
    exit 1
fi
echo "[sweep] phase 2/3: folding ${#SWEEP_FASTA[@]} FASTA(s) on ${NRANKS} tile(s)"
# shellcheck disable=SC2086  # FOLD_ARGS is deliberately word-split into separate flags
"${MPI_LAUNCH[@]}" python -m src.fold_fasta --device xpu "${SWEEP_FASTA[@]}" ${FOLD_ARGS:-}
rc=$?

# --- phase 3: the table ---------------------------------------------------------------------
# Runs even if folding faulted partway: every scored sequence is already fsynced, so a partial
# table beats no table, and the sweep rows that did complete are still comparable.
echo "[sweep] phase 3/3: summary (natural = ceiling, shuffled = composition-matched floor)"
python -m src.fold_fasta --summarize

echo "[job] exit $rc"; exit $rc     # exit $rc so the EXIT trap reports the true code
