#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N pld2_cond
#PBS -l walltime=06:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe

# Conditional-generation parameter sweep: prompts x guidance strengths, folded AND scored for
# SPECIFICITY.
#
# WHY THE SPECIFICITY PHASE EXISTS. pLDDT and pTM cannot tell conditioning from a general quality
# bump: guidance that made every sample slightly more protein-like would raise both while steering
# nothing, and would read as a success. Phase 4 scores every generated set against EVERY prompt in
# the sweep and reports the margin between a set's own prompt and the others -- which is immune to
# a set that simply scores well against everything. Each prompt's gamma=0 row is the null: it never
# saw a prompt, so its margin should sit at ~0 however well it folds.
#
# THE GRID. GAMMAS spans 0 (control) upward; every prompt is run at every gamma. Cost is
# len(PROMPTS) x len(GAMMAS) generation rounds, each of N sequences, plus folding. Guidance adds one
# AMPLIFY forward+backward per decoding step, so a guided round is ~2-3x an unguided one.
#
# BEST-OF-N COMPOSES WITH THIS and is the larger effect so far: on the unconditional sweep it took
# pTM 0.237 -> 0.284 (n=4) -> 0.321 (n=8) with k-mer repetition still at 0.0%, where every other
# knob that moved pTM bought it with degeneracy. GUIDE_BEST turns it on here; leave it at 1 for a
# clean read on guidance alone, then raise it once gamma is chosen.
#
# SEPARATE LIST ITEMS WITH COLONS, NOT COMMAS. `qsub -v` uses the comma to separate VARIABLES, so
# `-v PROMPTS=0,17,42` is read as PROMPTS=0 followed by a bare token `17`, and qsub rejects the
# whole submission with "cannot send environment with the job". PROMPTS and GAMMAS accept ':' and
# translate it below, so the comma never has to survive qsub's parser.
#
#   qsub scripts/conditional.pbs
#   qsub -v PROMPTS=0:17:42,GAMMAS=0:1:3 scripts/conditional.pbs
#   qsub -v GUIDE_BEST=8 scripts/conditional.pbs            # compose with the best-of-n win
#   qsub -v GUIDE_MODE=deg scripts/conditional.pbs          # exact enumeration, far slower
#   qsub -v N=32,GAMMAS=0:1 scripts/conditional.pbs         # a quick look
#   qsub -v GUIDE_CHUNK=4 scripts/conditional.pbs           # if the classifier OOMs
#
# Prompts should be SPREAD ACROSS THE CACHE, not adjacent. The cache is in accession order, so
# consecutive rows are frequently paralogs or isoforms whose captions read almost the same -- and
# the specificity test in phase 4 asks whether a sample scores higher against its own prompt than
# the others. Near-identical prompts make that discrimination impossible whether or not guidance
# works, so a flat margin would say nothing. The default is deliberately spread.
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./scripts/pbs_common.sh

N=${N:-64}                                  # sequences per (prompt, gamma)
PROMPTS=${PROMPTS:-0:150000:300000}         # cache rows or accessions; ':' or ',' separated
GAMMAS=${GAMMAS:-0:0.5:1:2:5}               # 0 is the unconditional control
PROMPTS=${PROMPTS//:/,}                     # qsub -v cannot carry a comma INSIDE a value
GAMMAS=${GAMMAS//:/,}
GUIDE_MODE=${GUIDE_MODE:-tag}
GUIDE_LIKELIHOOD=${GUIDE_LIKELIHOOD:-sigmoid}
GUIDE_BEST=${GUIDE_BEST:-1}
# Rows per classifier forward/backward. TAG's backward keeps a [chunk, 15, L, L] attention matrix
# per AMPLIFY layer, 32 of them, so peak memory is linear in this and quadratic in length: at
# chunk=64 on a 514-token canvas that is 30GB of attention on a tile already holding PLD2, which is
# the UR_RESULT_ERROR_OUT_OF_RESOURCES the first attempt hit. 8 costs ~3.8GB before trimming.
GUIDE_CHUNK=${GUIDE_CHUNK:-8}
SAMPLES=$(python -c "from config import SAMPLES_DIR; print(SAMPLES_DIR)")

job_banner "PLD2 conditional generation sweep" N PROMPTS GAMMAS GUIDE_MODE GUIDE_LIKELIHOOD \
           GUIDE_BEST GUIDE_CHUNK SAMPLES CKPT

CKPT_FLAG=""
[ -n "${CKPT:-}" ] && CKPT_FLAG="--ckpt ${CKPT}"

# --- phase 1: generate, one round per prompt ------------------------------------------------
# One invocation per prompt because guidance conditions on a single target; the gammas inside a
# round share the AMPLIFY load, which is the expensive part of startup. Filenames carry the prompt
# (filip_<prompt>_<tag>.fasta) so rounds cannot overwrite one another.
n_ok=0
IFS=',' read -ra PROMPT_LIST <<< "${PROMPTS}"
for prompt in "${PROMPT_LIST[@]}"; do
    echo "[cond] phase 1/4: prompt '${prompt}' at gammas ${GAMMAS} (${N} seqs each)"
    # shellcheck disable=SC2086
    "${MPI_LAUNCH[@]}" python -m src.sweep_sampler --device xpu --n "${N}" ${CKPT_FLAG} \
        --guide-prompt "${prompt}" --guide-gammas "${GAMMAS}" \
        --guide-mode "${GUIDE_MODE}" --guide-likelihood "${GUIDE_LIKELIHOOD}" \
        --guide-best "${GUIDE_BEST}" --guide-chunk "${GUIDE_CHUNK}" ${GUIDE_ARGS:-}
    rc=$?
    if [ $rc -eq 0 ]; then n_ok=$((n_ok + 1))
    else echo "[cond] prompt '${prompt}' failed (rc=$rc); continuing with the rest." >&2; fi
done
if [ $n_ok -eq 0 ]; then echo "[cond] every prompt failed; nothing to score." >&2; exit 1; fi

# --- phase 2: fold ---------------------------------------------------------------------------
shopt -s nullglob
COND_FASTA=( "${SAMPLES}"/sweep_filip_*.fasta )
shopt -u nullglob
if [ ${#COND_FASTA[@]} -eq 0 ]; then
    echo "[cond] no sweep_filip_*.fasta in ${SAMPLES} -- generation wrote nothing." >&2; exit 1
fi
# RELAUNCHED IN A LOOP, like scripts/self_consistency.pbs and for the same reason: ESMFold on
# Aurora aborts unpredictably, and folding is resumable (every scored sequence is fsynced and a
# rerun skips it on content). Without this a fault partway leaves the later FASTAs unscored, which
# is what happened on the first attempt -- prompt 2 never got folded at all and several rows came
# back at n=2..43 instead of n=64, so their pLDDT/pTM were computed over a biased handful.
# COUNT FOLDED RECORDS, NOT SUMMARY ROWS. The first version counted rows matching ^sweep_filip_ in
# the summary table, which is the number of FASTA GROUPS -- constant from the moment the files
# exist. So "before" and "after" were always equal, every attempt looked like no progress, and the
# loop gave up after the first fault having folded hundreds of sequences. Records are what actually
# accumulate: each is fsynced to a per-rank JSONL as it is scored.
FOLDS=$(python -c "from config import FOLDS_JSONL; print(FOLDS_JSONL)")
n_fold() { cat "${FOLDS%.jsonl}"*.jsonl 2>/dev/null | wc -l | tr -d " "; }
echo "[cond] phase 2/4: folding ${#COND_FASTA[@]} FASTA(s) on ${NRANKS} tile(s)"
t0=$SECONDS
for attempt in $(seq 1 "${FOLD_TRIES:-8}"); do
    before=$(n_fold)
    [ $(( SECONDS - t0 )) -ge "${FOLD_BUDGET:-10800}" ] && { echo "[cond] fold budget spent"; break; }
    # shellcheck disable=SC2086
    "${MPI_LAUNCH[@]}" python -m src.fold_fasta --device xpu "${COND_FASTA[@]}" ${FOLD_ARGS:-}
    frc=$?
    [ $frc -eq 0 ] && { echo "[cond] folding completed on attempt ${attempt}"; break; }
    after=$(n_fold)
    echo "[cond] fold attempt ${attempt} exited ${frc} (${before} -> ${after} sequences scored)"
    [ "${after}" -le "${before}" ] && { echo "[cond] no progress; not retrying"; break; }
done

# --- phase 3: the fold table -----------------------------------------------------------------
echo "[cond] phase 3/4: fold summary (natural = ceiling, shuffled = composition-matched floor)"
python -m src.fold_fasta --summarize

# --- phase 4: SPECIFICITY, which is the phase that answers the question ----------------------
# Single rank: it is one AMPLIFY pass over a few thousand short sequences, and the scores have to
# be computed against the same prompt set for every row to be comparable.
echo "[cond] phase 4/4: FILIP specificity -- does each set score highest against ITS OWN prompt?"
python -m src.filip_eval --device xpu --prompts "${PROMPTS}" --max-seqs "${N}" \
    --fasta "${SAMPLES}/sweep_filip_*.fasta"
erc=$?

rc=$(( frc != 0 ? frc : erc ))
echo "[job] exit $rc"; exit $rc     # exit $rc so the EXIT trap reports the true code
