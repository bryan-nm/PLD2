#!/bin/bash -l
#PBS -A NLDesignProtein
#PBS -N pld2_fsv
#PBS -l walltime=01:00:00
#PBS -l select=1
#PBS -l place=scatter
#PBS -l filesystems=home_fs:flare_fs
#PBS -q debug
#PBS -j oe

# Check consistency between folded generated sequences and foldseek re-tokenization
cd "${PBS_O_WORKDIR:?submit with qsub from the repo root}" || exit 1
source ./scripts/pbs_common.sh

job_banner "PLD2 Foldseek consistency check" 

# shellcheck disable=SC2086  # FOLD_ARGS is deliberately word-split into separate flags
python -m src.self_consistency --emit-reference 200
python -m src.fold_fasta --pdb-dir /flare/NLDesignProtein/bryan/Diffusion-dev-space/runs/pld2/samples/pdb
python -m src.self_consistency

rc=$?; echo "[job] exit $rc"; exit $rc     # exit $rc so the EXIT trap reports the true code
